# Copia este archivo a ".env" y rellena tus credenciales reales. Nunca subas ".env" a un repositorio.

# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Airtable -> Personal Access Token con permisos data.records:read y data.records:write
# sobre la base donde se guardarán los leads (https://airtable.com/create/tokens)
AIRTABLE_API_KEY=
# ID de la base, empieza con "app..." (se ve en la URL de la base o en la API docs de Airtable)
AIRTABLE_BASE_ID=
# Nombre exacto de la tabla donde se guardarán los leads
AIRTABLE_TABLE_NAME=Leads

# Resend -> https://resend.com/api-keys (no requiere verificar dominio para pruebas)
RESEND_API_KEY=
# Remitente del correo. Sin dominio verificado, debe ser "onboarding@resend.dev"
EMAIL_FROM=Lambda <onboarding@resend.dev>
# URL pública del sitio, usada en el botón del correo de confirmación
SITE_URL=https://lambda-leads.onrender.com

PORT=3000
